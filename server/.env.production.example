# Template for the SERVER's server/.env — copy to server/.env on the IIS
# server and fill in real values. Never commit the filled-in file (it's
# gitignored). This is NOT the same as your dev laptop's .env: several
# values below must differ between dev and the server (noted per line).

# Backend port. Must match the -BackendPort the NSSM service was installed
# with in deploy/deploy-iis.ps1 (default 7171) and the port IIS's
# reverse-proxy rule in deploy/web.config targets.
PORT=7171

# Not read by the app (CORS reflects the request origin instead — see
# server/src/app.ts) — kept only for reference/documentation.
CLIENT_URL=http://localhost:7070

# The server's own PostgreSQL instance — NOT the dev laptop's. Ask whoever
# manages the server's Postgres for the right user/password/db name, or see
# deploy/migrate-data.ps1's restore step if this is a fresh database.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/cwt_tax_portal

# Folder sync — canonical data source. On the server this should point at
# wherever deploy/migrate-data.ps1 copied the dev laptop's
# "CWT ledger_reference" folder to (e.g. C:/cwt-tax-portal/data/CWT ledger_reference),
# NOT the dev laptop's own Desktop path.
DATA_SYNC_DIR=C:/cwt-tax-portal/data/CWT ledger_reference

# Same folder as DATA_SYNC_DIR unless the server keeps zonal values
# somewhere separate.
ZONAL_VALUES_DIR=C:/cwt-tax-portal/data/CWT ledger_reference

# IT-issued read-only API keys (Prompters API broker) — copy the same
# values from the dev laptop's server/.env (these are tied to the key
# holder/scope, not the machine, so they don't need to change).
TAX_TEAM_API_KEY=
PROPERTY_SALES_API_KEY=

# DOAS Notary Endorsement System — source of each contract's CTS notary date
# and unit/parking SQM (read-only GETs against /api/batches). Defaults to the
# LAN host below if left unset; it must be reachable from this server.
DOAS_API_URL=http://192.168.16.239:4100

# Shared login — copy the same values from the dev laptop's server/.env so
# the team's one set of credentials keeps working on the server too.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Generate a fresh random value for the server rather than reusing the dev
# laptop's — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# Reference data (OCLP 1606 Summary, RPT/FMV table, zonal values) is read-only
# in the web app — it is loaded only from DATA_SYNC_DIR / ZONAL_VALUES_DIR.
# Leave this unset (or false) to keep it locked. Set to true ONLY on a machine
# where someone must be able to upload/edit reference data through the app.
# ALLOW_REFERENCE_EDITS=false

# ONETT Summary — automatic reading of uploaded scanned ONETT PDFs.
# With a key set, every PDF uploaded on the ONETT Summary page is read page by
# page (handwriting included) and the summary + Excel are produced by themselves.
# Without it, uploads are saved and wait as "Awaiting data".
# The server must be able to reach https://api.anthropic.com (outbound HTTPS 443).
# ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5) and parallel page reads (default 3).
# ONETT_VISION_MODEL=
# ONETT_READ_CONCURRENCY=3
